import { LineEdit, Button, Palette, ScrollView } from "std-widgets.slint";

export component AppBar inherits Rectangle {
    in-out property <string> title;
    in-out property <image> trailing-icon;
    callback icon-clicked();

    height: 58px;
    background: Palette.control-background;

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: title;
            font-size: 20px;
            font-weight: 600;
            vertical-alignment: center;
            width: 80%;
        }

        Button {
            icon: trailing-icon;
            colorize-icon: true;
            clicked => {
                icon-clicked()
            }
        }
    }
}

export component FileInput {
    in-out property <string> path;
    in-out property <bool> folder: false;
    callback edited <=> le.edited;
    callback choose-file();

    HorizontalLayout {
        spacing: 4px;
        le := LineEdit {
            text: path;
        }

        Button {
            icon: folder ? @image-url("../resources/folder_open.svg") : @image-url("../resources/file_open.svg");
            colorize-icon: true;
            clicked => {
                choose-file()
            }
        }
    }
}

export component CompositeButton inherits Rectangle {
    // Public properties
    in property <bool> enabled: true;
    in property <color> tint: #636363;

    // Callback
    callback clicked();

    // Styling
    background: Palette.control-background;
    border-radius: 4px;
    min-width: 80px;
    min-height: 32px;

    @children

    // Touch area for interaction
    ta := TouchArea {
        enabled: root.enabled;
        forward-focus: focus-scope;

        focus-scope := FocusScope {
            x: 0;
            width: 0;
            enabled: root.enabled;

            key-pressed(event) => {
                // Trigger click on Space or Enter
                if (event.text == " " || event.text == "\n") {
                    root.clicked();
                    return accept;
                }
                return reject;
            }
        }

        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }

        // Overlay for visual feedback
        overlay := Rectangle { }

        states [
            disabled when !root.enabled: {
                overlay.background: root.tint.with-alpha(0.10);
            }
            pressed when ta.pressed && root.enabled: {
                overlay.background: root.tint.with-alpha(0.30);
            }
            hover when ta.has-hover && root.enabled: {
                overlay.background: root.tint.with-alpha(0.20);
            }
        ]
    }
}

export component LineEditWithLabel inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in-out property <bool> enabled <=> edit.enabled;
    callback edited <=> edit.edited;
    height: 64px;
    VerticalLayout {
        spacing: 6px;
        Text {
            text: label;
        }

        edit := LineEdit {
            text: text;
        }
    }
}

export component FileInputWithLabel inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in-out property <bool> folder <=> file-input.folder;
    callback choose-file <=> file-input.choose-file;
    callback edited <=> file-input.edited;
    height: 64px;
    VerticalLayout {
        spacing: 6px;
        Text {
            text: label;
        }

        file-input := FileInput {
            height: 36px;
            path: text;
        }
    }
}
